{
  "name": "ember-grain-platform",
  "version": "2.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter @ember-grain/db prisma generate && pnpm --filter web build",
    "postinstall": "pnpm --filter @ember-grain/db prisma generate",
    "start": "node apps/web/.next/standalone/apps/web/server.js",
    "lint": "pnpm -r --filter=./apps/* lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "db:generate": "pnpm --filter @ember-grain/db prisma generate",
    "db:migrate": "pnpm --filter @ember-grain/db prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter @ember-grain/db prisma migrate deploy",
    "db:seed": "pnpm --filter @ember-grain/db prisma db seed",
    "db:studio": "pnpm --filter @ember-grain/db prisma studio"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "protobufjs"
    ]
  }
}
