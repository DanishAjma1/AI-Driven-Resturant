# Postgres, matches docker-compose.yml at the repo root.
DATABASE_URL="postgresql://{username}:{password}@localhost:5432/resturant?schema=public"

# Generate with: openssl rand -base64 48
JWT_SECRET="replace-with-a-random-32+-character-secret"

# Optional — omit to fall back to the local heuristic recommender/forecaster.
GOOGLE_GENAI_API_KEY="your-api-key"

# Resend (transactional email) settings for password-reset emails.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="noreply@your-domain.com"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
